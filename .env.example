# Copy to .env (or set in your host's dashboard). Never commit real values.
PORT=4999
NODE_ENV=production
# Any long random string, for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
# Where the SQLite file lives. On a host, point this at a persistent disk.
DATABASE_PATH=./data/taxjar.db
